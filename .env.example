# Core
PORT=3000
NODE_ENV=development
SESSION_SECRET=super_secret_session_key_that_should_be_changed
ADMIN_USER=admin
ADMIN_PASSWORD=atlas123

# Bitrix24
BITRIX_WEBHOOK_URL=https://b24-xxxxxx.bitrix24.com/rest/1/xxxxxx/
BITRIX_CATEGORY_ID=1
BITRIX_STAGE_TRIGGER=C1:NEW
BITRIX_STAGE_SENT=C1:PREPARATION
BITRIX_STAGE_SIGNED=C1:EXECUTING
BITRIX_STAGE_CANCELLED=C1:LOSE
BITRIX_STAGE_WON_FOR_BILLING=C1:WON

# D4Sign
D4SIGN_BASE_URL=https://app.d4sign.com.br/api/v1
D4SIGN_TOKEN_API=your_api_token
D4SIGN_CRYPT_KEY=your_crypt_key
D4SIGN_HMAC_SECRET=your_hmac_secret
D4SIGN_UUID_SAFE=your_uuid_safe
D4SIGN_TEMPLATE_ID=your_template_id
D4SIGN_UUID_FOLDER=your_uuid_folder

# NXFacil
NXFACIL_MODE=mock
NXFACIL_BASE_URL=https://api.nxfacil.com.br/v1
NXFACIL_API_TOKEN=your_nxfacil_token

# Webhook
WEBHOOK_SECRET=my_webhook_secret_for_validation

# Sicredi
SICREDI_CLIENT_ID=your_sicredi_client_id
SICREDI_CLIENT_SECRET=your_sicredi_client_secret
SICREDI_CEDENTE=your_cedente_code
SICREDI_CARTEIRA=your_carteira_code

# Sync
SINCRONIZACAO_MINUTOS=15

# AI
AI_PROVIDER=anthropic
AI_API_KEY=your_anthropic_api_key
AI_MODEL=claude-sonnet-4-20250514
