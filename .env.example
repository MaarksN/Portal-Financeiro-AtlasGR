# ------------------------------------------------------------------
# Nada aqui é obrigatório para rodar localmente: sem nenhuma fonte
# configurada, o portal sobe sozinho em MODO DEMONSTRAÇÃO — banco
# SQLite local, dados semeados (usuários, carteira de cobrança,
# relatórios de reembolso). Copie este arquivo para .env e preencha
# só o que for usar de verdade.
# ------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Obrigatório em produção (NODE_ENV=production); em dev, se omitido,
# um segredo é gerado sozinho e guardado em dados/.segredo-dev.
# SESSION_SECRET=troque-por-um-segredo-forte-de-32-caracteres-ou-mais

# Onde o banco SQLite e os comprovantes de reembolso ficam guardados.
# ATLAS_DADOS=./dados

# ============================== Bitrix24 ==============================
# Leitura: consulta direta via crm.item.list (webhook próprio, só leitura).
BITRIX_WEBHOOK=https://suaempresa.bitrix24.com.br/rest/1/xxxxxxxx
ENTITY_TYPE_ID_REEMBOLSO=1034
ENTITY_TYPE_ID_COBRANCA=1032
# Nomes dos campos customizados da SPA de cobrança — ajuste se o seu
# provisionamento gerou nomes diferentes de ufCrm_*.
# BITRIX_CAMPO_DOCUMENTO=ufCrm_DOCUMENTO
# BITRIX_CAMPO_CLIENTE=ufCrm_CLIENTE
# BITRIX_CAMPO_CLIENTE_DOC=ufCrm_CLIENTE_DOC
# BITRIX_CAMPO_VALOR=ufCrm_VALOR
# BITRIX_CAMPO_VALOR_PAGO=ufCrm_VALOR_PAGO
# BITRIX_CAMPO_EMISSAO=ufCrm_EMISSAO
# BITRIX_CAMPO_VENCIMENTO=ufCrm_VENCIMENTO
# BITRIX_CAMPO_PAGAMENTO=ufCrm_PAGAMENTO

# ==================== Serviço de integração existente ====================
# O que já recebe POST /evento do ERP hoje. O portal usa o MESMO
# contrato (HMAC SHA-256) para espelhar reembolsos no Bitrix.
# Comentado de propósito: com valor preenchido (mesmo de exemplo), o
# portal entende que a integração está configurada de verdade.
# INTEGRACAO_URL=https://integracao.atlasgr.com.br
# SEGREDO_ENTRADA=troque-por-um-segredo-forte

# ======================= Fontes de cobrança adicionais =======================
# Connect Plus (legado, connect.atlasgr.com.br) — endpoint REST próprio.
# CONNECT_BASE=https://connect.atlasgr.com.br
# CONNECT_TOKEN=
# CONNECT_CAMINHO_COBRANCAS=/api/cobrancas

# Perfil Securitário (Next.js, perfil-securitario.atlasgr.com.br).
# PERFIL_BASE=https://perfil-securitario.atlasgr.com.br
# PERFIL_TOKEN=
# PERFIL_CAMINHO_COBRANCAS=/api/report/billing

# Sem endpoint de API para Connect Plus / Perfil Securitário ainda?
# Use "Importar CSV" na tela Fontes e integrações — funciona sem
# nenhuma variável de ambiente.

# =========================== Assistente de IA ===========================
# Sem chave, a tela do Assistente sobe desligada com aviso claro — o
# resto do portal funciona normalmente.
# ANTHROPIC_API_KEY=
# IA_MODELO=claude-sonnet-5

# ============================== Anexos ==============================
# ANEXO_TAMANHO_MAX_MB=10

# ============================ Política de despesa ============================
# Tetos padrão em REAIS (a tabela politica_categorias no banco pode
# sobrepor por categoria — ver db/seed.js).
# POLITICA_COMPROVANTE_ACIMA_DE=0
# POLITICA_PRAZO_LANCAMENTO_DIAS=60
# ALCADA_COORDENACAO=1000
# ALCADA_GERENCIA=5000

# ============================ Sincronização ============================
# Minutos entre ciclos automáticos (puxa cobranças, drena o espelho).
# 0 desliga. Em modo demonstração já fica 0 por padrão.
# SINCRONIZACAO_MINUTOS=15

# Atrás de proxy reverso / load balancer (produção):
# ATRAS_DE_PROXY=true
